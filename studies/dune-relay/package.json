{
  "name": "dune-relay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test:core": "node scripts/check-core.cjs && node scripts/check-jit-tools.cjs && node scripts/check-lifecycle.cjs && node scripts/check-audio.cjs && node scripts/check-companion-dialogue.cjs && node scripts/check-cascade-flair.cjs && node scripts/check-crate-exits.cjs && node scripts/check-river-chapter.cjs",
    "music:export": "node scripts/export-music.cjs",
    "test:browser": "node scripts/check-browser.cjs",
    "test:river-browser": "node scripts/check-river-chapter-browser.cjs && node scripts/check-river-recovery-browser.cjs && node scripts/check-river-routes-browser.cjs",
    "test:river-film-browser": "node scripts/check-river-finale-film-browser.cjs",
    "test:pwa-browser": "node scripts/check-pwa-browser.cjs",
    "test:public-access": "node scripts/check-public-access.cjs",
    "test:companion-browser": "node scripts/check-companion-browser.cjs",
    "test:play-feel": "node scripts/check-play-feel.cjs",
    "test:collections": "node scripts/check-collections.cjs",
    "test:stats": "node scripts/check-stats-layout.cjs",
    "build:artifact": "node scripts/build-artifact.mjs",
    "build:preview": "node scripts/build-preview.mjs",
    "test:tutorials": "node scripts/check-tutorials.cjs",
    "test:tutorial-browser": "node scripts/check-tutorial-browser.cjs",
    "test:shop-browser": "node scripts/check-shop-browser.cjs",
    "test:jit-browser": "node scripts/check-jit-browser.cjs && node scripts/check-jit-recovery-browser.cjs",
    "test:chain-callout": "node scripts/check-chain-callout.cjs"
  },
  "dependencies": {
    "next": "15.5.29",
    "phaser": "3.90.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "playwright": "1.62.1",
    "typescript": "5.9.3"
  }
}
