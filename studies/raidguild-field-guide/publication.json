          "type": "steps",
          "items": [
            {
              "id": "direction",
              "title": "Agree on the destination",
              "text": "Clarify the client’s need, intended outcomes, deliverables, responsibilities, timeline, and budget. Give the party a shared destination.",
              "sourceIds": [
                "raids"
              ]
            },
            {
              "id": "coordination",
              "title": "Keep the party connected",
              "text": "Keep decisions, progress, and next actions visible. Coordinate internally and agree on a useful communication channel with the client.",
              "sourceIds": [
                "raids"
              ]
            },
            {
              "id": "agreements",
              "title": "Make the engagement clear",
              "text": "Agree scope, milestones, responsibilities, commercial terms, payment schedule, and the party split before the engagement is authorized to start.",
              "sourceIds": [
                "raids"
              ]
            },
            {
              "id": "build",
              "title": "Build with complementary skills",
              "text": "Bring the right skills together and make responsibility for each part clear. The party delivers the agreed work, with an agreed delivery lead when assigned.",
              "sourceIds": [
                "raids"
              ]
            },
            {
              "id": "review",
              "title": "Review the work together",
              "text": "Share work, gather feedback, and check it against the agreed outcomes. Keep the client relationship and delivery expectations aligned as the work develops.",
              "sourceIds": [
                "raids"
              ]
            },
            {
              "id": "handover",
              "title": "Deliver and close the loop",
              "text": "Confirm acceptance, hand over the work, resolve final payment and distributions, and leave useful documentation. Capture lessons for the next party.",
              "sourceIds": [
                "raids"
              ]
            },
            {
              "id": "support",
              "title": "Keep the expedition running",
              "text": "Contracts, records, and financial administration support the party’s work. Coordinate with the responsible operators and use the approved systems.",
              "sourceIds": [
                "raids"
              ]
            }
